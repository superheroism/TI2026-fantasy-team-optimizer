{
  "name": "dota2-fantasy-optimizer",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "verify:generated": "node scripts/verify-generated.mjs --check-committed",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:ci": "npm run typecheck && npm run lint && npm run verify:generated && node --test tests/*.test.mjs",
    "test:performance-contracts": "npm run build && node --test tests/banner-mechanics-key.test.mjs tests/scenario-reuse.test.mjs tests/target-diagnostics.test.mjs tests/team-comparison-cache.test.mjs tests/production-readiness.test.mjs",
    "test:ocr-corpus": "npm run build && node scripts/test-ocr-corpus.mjs",
    "test:screenshot-e2e": "node scripts/test-screenshot-e2e.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "benchmark:v1": "npm run test:ci && node scripts/benchmark-m7b-v1.mjs",
    "lint": "eslint src scripts tests",
    "format:check": "prettier --check src scripts tests *.md",
    "format": "prettier --write src scripts tests *.md"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.67.0"
  }
}
