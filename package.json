{
  "name": "dota2-fantasy-optimizer",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "verify:generated": "node scripts/verify-generated.mjs --check-committed",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:ci": "npm run typecheck && npm run verify:generated && node --test tests/*.test.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "benchmark:m5": "npm run build && node scripts/benchmark-m5-four-token.mjs",
    "benchmark:m5d": "npm run test:ci && node scripts/benchmark-m5d.mjs",
    "benchmark:m5d:plan": "node scripts/benchmark-m5d.mjs --plan",
    "benchmark:m5e": "npm run test:ci && node scripts/benchmark-m5e-target.mjs --preflight-passed",
    "benchmark:m5e:plan": "node scripts/benchmark-m5e-target.mjs --plan",
    "benchmark:m5f": "npm run test:ci && node scripts/benchmark-m5f-target.mjs --preflight-passed",
    "benchmark:m5f:plan": "node scripts/benchmark-m5f-target.mjs --plan",
    "benchmark:m5f:kernel": "npm run build && node scripts/benchmark-m5f-target-kernel.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
